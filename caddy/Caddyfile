# Caddy は {$DOMAIN} に対して Let's Encrypt の証明書を自動取得・自動更新する。
# 手作業のSSL設定が要らないのがポイント(ここが最初の「面倒が消える」体験)。
#
# ローカルで試すだけなら、下の {$DOMAIN} のブロックはコメントアウトして
# `:80` のブロックを使うと http://localhost で動く。

#{$DOMAIN} {
#	# Open WebUI にリバースプロキシ
#	reverse_proxy open-webui:8080
#}

 #---- ローカル検証用 (ドメインが無いとき) ----
 :80 {
 	reverse_proxy open-webui:8080
 }

# ---- 秘書(authentik で保護) ----
# authentik は External host と一致する Host ヘッダーでないと
# どのアプリの認証か判断できないため、明示的に固定する。
(secretary_headers) {
	header_up Host llm-homelab.tail64a8a5.ts.net:10000
	header_up X-Forwarded-Host llm-homelab.tail64a8a5.ts.net:10000
	header_up X-Forwarded-Proto https
}

:8080 {
	route {
		reverse_proxy /outpost.goauthentik.io/* http://host.docker.internal:9000 {
			import secretary_headers
		}

		forward_auth http://host.docker.internal:9000 {
			uri /outpost.goauthentik.io/auth/caddy
			copy_headers X-authentik-username X-authentik-groups X-authentik-email X-authentik-name X-authentik-uid
			trusted_proxies private_ranges
			import secretary_headers
		}

		reverse_proxy http://host.docker.internal:8000 {
			header_up X-Proxy-Secret {$PROXY_SECRET}
		}
	}
}
